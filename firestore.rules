rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Open-access portal: the admin console has no password gate and many
    // students write exams concurrently from different devices, so the app
    // collections are readable/writable by all clients. The admin uploads
    // question banks here and every student device pulls them live.
    // NOTE: Deploy these rules with `firebase deploy --only firestore:rules`.
    match /students/{doc} {
      allow read, create, update, delete: if true;
    }
    match /courses/{doc} {
      allow read, create, update, delete: if true;
    }
    match /quizzes/{doc} {
      allow read, create, update, delete: if true;
    }
    match /questionBanks/{doc} {
      allow read, create, update, delete: if true;
    }
    match /attempts/{doc} {
      allow read, create, update, delete: if true;
    }
    match /results/{doc} {
      allow read, create, update, delete: if true;
    }
    match /notifications/{doc} {
      allow read, create, update, delete: if true;
    }
    match /config/{doc} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /system/{doc} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /adminLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // JAMB-style live control plane (batch 4): admin actions stream here and
    // every student device listens. Deploy with `firebase deploy --only firestore:rules`.
    match /examControl/{doc} {
      allow read, create, update, delete: if true;
    }
    match /liveAnnouncements/{doc} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /presence/{doc} {
      allow read, create, update, delete: if true;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
