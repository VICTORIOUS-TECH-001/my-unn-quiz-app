rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || request.auth.token.email == 'hillarymmaka@gmail.com'
        );
    }

    // The current student login is registration-number based. Keep reads available
    // for the existing portal, but require the Firebase admin custom claim for
    // destructive operations.
    match /{document=**} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Exam submission is performed by the student portal after the exam ends.
    match /results/{resultId} {
      allow create: if true;
      allow update: if isAdmin();
      allow read: if true;
      allow delete: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
